{
  "name": "parcelscreen",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:pure": "tsc --noEmit -p tsconfig.pure.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "expected": "vitest run test/tools/expected.test.ts --mode expected",
    "diff:prototype": "vitest run test/tools/diff-prototype.test.ts --mode diff-prototype",
    "before-after": "vitest run test/tools/before-after.test.ts --mode before-after",
    "guard:expected": "vitest run test/tools/expected-guard.test.ts --mode guard",
    "check:pins": "vitest run test/tools/pins.test.ts",
    "check:fixtures": "vitest run test/tools/fixture-size.test.ts",
    "turf-versions": "vitest run test/tools/turf-versions.test.ts --mode turf-versions",
    "geotiff-versions": "vitest run test/tools/geotiff-versions.test.ts --mode geotiff-versions",
    "record:fixtures": "node scripts/record-fixtures.mts",
    "data:hospitals": "node scripts/data-hospitals.mts",
    "check:hospitals-age": "node scripts/check-hospitals-age.mts",
    "check:deployed": "node scripts/check-deployed.mts",
    "record:port": "vitest run test/tools/record-port.test.ts --mode record-port",
    "study:grades": "vitest run test/tools/grade-study.test.ts --mode grade-study",
    "a3:analysis": "vitest run test/tools/a3-analysis.test.ts --mode a3",
    "a3:curve": "vitest run test/tools/a3-curve.test.ts --mode a3-curve",
    "a3b:router": "vitest run test/tools/a3b-router.test.ts --mode a3b",
    "a4:driveway": "vitest run test/tools/a4-driveway.test.ts --mode a4-driveway",
    "a4b:realism": "vitest run test/tools/a4b-realism.test.ts --mode a4b-realism"
  },
  "dependencies": {
    "@serwist/turbopack": "9.5.13",
    "@turf/turf": "7.4.0",
    "fast-png": "^8.0.0",
    "geotiff": "2.1.3",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "9.5.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "~0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
